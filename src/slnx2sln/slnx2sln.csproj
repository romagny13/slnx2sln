<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0</TargetFramework>

		<IsPackable>true</IsPackable>
		<!-- Creates the .nupkg file on each build -->
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>

		<!-- Package info -->
		<Authors>romagny13</Authors>
		<Description>Converts between modern .slnx and classic .sln solution files.</Description>
		<PackageTags>sln;slnx;solution;visualstudio;dotnet;tool</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>

		<!-- Repository -->
		<RepositoryUrl>https://github.com/romagny13/slnx2sln</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageProjectUrl>https://github.com/romagny13/slnx2sln</PackageProjectUrl>

		<!-- Optional but recommended -->
		<Copyright>Copyright (c) romagny13</Copyright>
		<PackageReleaseNotes>Initial release. Supports bidirectional conversion between .sln and .slnx.</PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup>
	  <PackageReference Include="Microsoft.VisualStudio.SolutionPersistence" Version="1.0.52" />
	</ItemGroup>


</Project>
